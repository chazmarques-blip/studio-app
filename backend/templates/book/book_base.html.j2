<!DOCTYPE html>
<html lang="{{ book.language }}">
<head>
<meta charset="UTF-8" />
<title>{{ book.title }}</title>
<style>
  @page {
    size: {{ trim.width }}mm {{ trim.height }}mm;
    margin: {{ layout.margins_mm.top }}mm {{ layout.margins_mm.outer }}mm {{ layout.margins_mm.bottom }}mm {{ layout.margins_mm.inner }}mm;
    bleed: 3mm;
    marks: crop cross;
    {% if layout.show_running_headers %}
    @top-left { content: string(book-title); font-size: 9pt; font-style: italic; color: #555; }
    @top-right { content: string(chapter-title); font-size: 9pt; font-style: italic; color: #555; }
    {% endif %}
    @bottom-center { content: counter(page); font-size: 10pt; color: #333; }
  }
  @page :first { @top-left { content: ""; } @top-right { content: ""; } @bottom-center { content: ""; } }

  html, body {
    font-family: {{ layout.font_family }};
    font-size: {{ layout.font_size_pt }}pt;
    line-height: {{ layout.line_height }};
    color: #111;
    hyphens: {{ layout.hyphens }};
    text-align: justify;
    orphans: {{ layout.orphans }};
    widows: {{ layout.widows }};
  }

  .cover {
    page-break-after: always;
    margin: -{{ layout.margins_mm.top }}mm -{{ layout.margins_mm.outer }}mm -{{ layout.margins_mm.bottom }}mm -{{ layout.margins_mm.inner }}mm;
    width: {{ trim.width + 6 }}mm;
    height: {{ trim.height + 6 }}mm;
    background-size: cover;
    background-position: center;
    position: relative;
    color: #fff;
    string-set: book-title "{{ book.title }}";
  }
  .cover-title {
    position: absolute;
    bottom: 30mm;
    left: 0; right: 0;
    text-align: center;
    font-size: 36pt;
    font-weight: 800;
    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
    padding: 0 20mm;
  }
  .cover-subtitle {
    position: absolute;
    bottom: 18mm;
    left: 0; right: 0;
    text-align: center;
    font-size: 14pt;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }
  .cover-author {
    position: absolute;
    bottom: 8mm;
    left: 0; right: 0;
    text-align: center;
    font-size: 12pt;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-shadow: 0 1px 3px rgba(0,0,0,0.8);
  }

  .title-page {
    page-break-after: always;
    text-align: center;
    padding-top: 40mm;
  }
  .title-page h1 { font-size: 28pt; font-weight: 700; margin-bottom: 12mm; }
  .title-page h2 { font-size: 14pt; font-style: italic; color: #555; margin-bottom: 30mm; }
  .title-page .author { font-size: 12pt; letter-spacing: 1.5px; text-transform: uppercase; }

  .copyright-page {
    page-break-after: always;
    font-size: 9pt;
    color: #555;
    padding-top: 80%;
  }

  .chapter {
    {% if layout.chapter_start_recto %}
    page-break-before: right;
    {% else %}
    page-break-before: always;
    {% endif %}
    string-set: chapter-title attr(data-title);
  }

  .chapter h2 {
    font-size: {{ (layout.font_size_pt * 2) | round(0) }}pt;
    font-weight: 700;
    text-align: left;
    margin-top: 30mm;
    margin-bottom: 14mm;
    page-break-after: avoid;
  }

  .chapter p { margin: 0 0 0.5em 0; text-indent: 1.2em; }
  .chapter p:first-of-type { text-indent: 0; }

  {% if layout.drop_cap %}
  .chapter p:first-of-type::first-letter {
    font-size: {{ (layout.font_size_pt * 3) | round(0) }}pt;
    font-weight: 700;
    line-height: 1;
    padding-right: 2pt;
  }
  {% endif %}

  /* ─── ILLUSTRATIONS — uniform finishing across all tiers ──────── */
  /* Design rule: all images get the same corner radius (2mm), same subtle
     border (0.3mm warm grey), same figcaption treatment. Three size tiers:
       .full-page  → own dedicated page, framed w/ margin so radius is visible
       .half       → banner inside a text page (full width, ~80mm tall)
       .spot       → inline, float right, ~55mm wide, text wraps around it
  */
  figure.illustration {
    page-break-inside: avoid;
    text-align: center;
    margin: 5mm 0;
  }
  figure.illustration img {
    display: block;
    margin: 0 auto;
    border-radius: 2mm;
    border: 0.3mm solid #e3ddd0;
    box-sizing: border-box;
    background: #fff;
  }
  figure.illustration figcaption {
    font-family: 'EB Garamond', Garamond, serif;
    font-size: 8.5pt;
    font-style: italic;
    color: #7a6a52;
    margin-top: 2mm;
    text-align: center;
    max-width: 85%;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.3;
  }

  /* TIER 1: FULL-PAGE — dedicated page, framed inset so radius is visible */
  figure.illustration.full-page {
    page-break-before: always;
    page-break-after: always;
    margin: 8mm 6mm;
    text-align: center;
  }
  figure.illustration.full-page img {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 185mm;
    object-fit: cover;
  }
  figure.illustration.full-page figcaption {
    margin-top: 5mm;
    font-size: 9.5pt;
  }

  /* TIER 2: HALF / BANNER — horizontal banner inside a text page */
  figure.illustration.half {
    page-break-inside: avoid;
    margin: 6mm 0;
    text-align: center;
  }
  figure.illustration.half img {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 90mm;
    object-fit: cover;
  }

  /* TIER 3: SPOT — inline, floats right, TEXT WRAPS AROUND IT */
  figure.illustration.spot {
    float: right;
    width: 55mm;
    margin: 0 0 3mm 5mm;
    padding: 0;
    text-align: center;
  }
  figure.illustration.spot img {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 70mm;
    object-fit: cover;
  }
  figure.illustration.spot figcaption {
    font-size: 7.5pt;
    margin-top: 1.5mm;
    max-width: 100%;
  }

  /* Section breaks clear any floating spot so the next section starts fresh */
  .section-break, .chapter-opener, h2 {
    clear: both;
  }

  /* SPREAD type → render as full-page banner for now */
  figure.illustration.spread {
    page-break-before: always;
    page-break-after: always;
    margin: 8mm 0;
  }
  figure.illustration.spread img {
    width: 100%;
    height: auto;
    max-height: 185mm;
    object-fit: cover;
    border-radius: 2mm;
  }

  /* Chapter opener styles (set by Diagramador Master) */
  .chapter-opener.drop_cap + p::first-letter {
    font-size: {{ (layout.font_size_pt * 2.4) | round(0) }}pt;
    font-weight: 700;
    line-height: 1;
    padding-right: 2pt;
    color: #333;
  }
  .chapter-opener.cinematic {
    text-align: center;
    font-family: {{ layout.font_family }};
    font-size: {{ (layout.font_size_pt * 1.4) | round(1) }}pt;
    font-style: italic;
    color: #666;
    margin: 4mm auto 8mm auto;
    max-width: 80%;
  }
  .chapter-opener.cinematic::before { content: "✦"; display: block; font-size: 16pt; color: #9E7D4A; margin-bottom: 4mm; }
  .chapter-opener .epigraph { font-style: italic; color: #666; text-align: center; margin: 2mm auto 6mm auto; max-width: 70%; }

  /* Pull quote (set by Diagramador Master) */
  .pull-quote {
    page-break-inside: avoid;
    font-family: {{ layout.font_family }};
    font-size: {{ (layout.font_size_pt * 1.35) | round(1) }}pt;
    line-height: 1.35;
    font-style: italic;
    color: #333;
    text-align: center;
    border-top: 0.5pt solid #c9a96e;
    border-bottom: 0.5pt solid #c9a96e;
    padding: 6mm 8mm;
    margin: 8mm 10mm;
  }
  .pull-quote .attribution { display: block; font-size: {{ layout.font_size_pt }}pt; font-style: normal; color: #888; margin-top: 3mm; letter-spacing: 1px; }

  /* Section break (soft rest between acts) */
  .section-break {
    page-break-inside: avoid;
    text-align: center;
    font-size: 14pt;
    color: #c9a96e;
    letter-spacing: 1em;
    margin: 8mm auto;
    padding-right: -1em;
  }
  .section-break::before { content: "✦ ✦ ✦"; }
</style>
</head>
<body>

{% if cover.front_url %}
<section class="cover" style="background-image: url('{{ cover.front_url }}');">
  <div class="cover-title">{{ cover.title or book.title }}</div>
  {% if cover.subtitle %}<div class="cover-subtitle">{{ cover.subtitle }}</div>{% endif %}
  {% if cover.author_name %}<div class="cover-author">{{ cover.author_name }}</div>{% endif %}
</section>
{% endif %}

<section class="title-page">
  <h1>{{ book.title }}</h1>
  {% if book.subtitle %}<h2>{{ book.subtitle }}</h2>{% endif %}
  {% if book.author %}<p class="author">{{ book.author }}</p>{% endif %}
</section>

<section class="copyright-page">
  <p>&copy; {{ book.author or 'Todos os direitos reservados' }}. Impresso via BookFactory — Studio X.</p>
</section>

{% macro render_illustration(illus) %}
  {%- set t = illus.type or 'full' -%}
  {# Map types to CSS tiers: full-page | half | spot | spread #}
  {%- if t == 'full' -%}
    {%- set cls = 'full-page' -%}
  {%- elif t == 'half' or t == 'banner' -%}
    {%- set cls = 'half' -%}
  {%- elif t == 'spot' -%}
    {%- set cls = 'spot' -%}
  {%- elif t == 'spread' -%}
    {%- set cls = 'spread' -%}
  {%- else -%}
    {%- set cls = 'full-page' -%}
  {%- endif -%}
  <figure class="illustration {{ cls }}">
    <img src="{{ illus.illustration_url }}" alt="" />
    {% if illus.caption %}<figcaption>{{ illus.caption }}</figcaption>{% endif %}
  </figure>
{% endmacro %}

{% for ch in chapters %}
<section class="chapter" data-title="{{ ch.title }}">
  <h2>{{ ch.title }}</h2>
  {%- set blocks = ch._blocks or [] -%}
  {% if blocks %}
    {% for b in blocks %}
      {% if b.type == 'chapter_opener' %}
        <div class="chapter-opener {{ b.style or 'drop_cap' }}">{% if b.epigraph %}<div class="epigraph">"{{ b.epigraph }}"</div>{% endif %}</div>
      {% elif b.type == 'illus' %}
        {{ render_illustration(b.data) }}
      {% elif b.type == 'pullquote' %}
        <blockquote class="pull-quote">"{{ b.text }}"{% if b.attribution %}<span class="attribution">— {{ b.attribution }}</span>{% endif %}</blockquote>
      {% elif b.type == 'section_break' %}
        <div class="section-break"></div>
      {% else %}
        <p>{{ b.text | replace('\n', ' ') }}</p>
      {% endif %}
    {% endfor %}
  {% else %}
    {# Fallback: if no _blocks computed, render prose paragraphs only #}
    {% set paragraphs = ch.prose.split('\n\n') %}
    {% for p in paragraphs %}
      {% if p.strip() and not p.strip().startswith('##') %}
        <p>{{ p.strip() | replace('\n', ' ') }}</p>
      {% endif %}
    {% endfor %}
  {% endif %}
</section>
{% endfor %}

{# Blank pages at end to reach multiple-of-4 page count (signature requirement) #}
{% for _ in range(blank_pages_count or 0) %}
<section class="blank-page" style="page-break-before: always; page-break-after: always;">&nbsp;</section>
{% endfor %}

</body>
</html>
